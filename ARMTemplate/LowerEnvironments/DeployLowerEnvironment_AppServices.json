{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "agency": {
            "defaultValue": "LatvianVillageCloudware",
            "type": "string"
        },
        "project": {
            "defaultValue": "WeShopAlot",
            "type": "string"
        },
        "division": {
            "defaultValue": "ECommerce",
            "type": "string"
        },
        "environment": {
            "defaultValue": null,
            "type": "string"
        },
        "external_portal_name": {
            "defaultValue": null,
            "type": "string"
        },
        "external_portal_url": {
            "defaultValue": null,
            "type": "string"
        },
        "admin_portal_name": {
            "defaultValue": null,
            "type": "string"
        },
        "admin_portal_url": {
            "defaultValue": null,
            "type": "string"
        },
        "api_name": {
            "defaultValue": null,
            "type": "string"
        },
        "publishing_username": {
            "defaultValue": null,
            "type": "string"
        },
        "appServicePlan_Id": {
            "defaultValue": "/subscriptions/bad79483-da4e-4319-a118-458df00fa996/resourceGroups/LL-NonProd/providers/Microsoft.Web/serverfarms/WSA-WebApp",
            "type": "string"
        },
        "configuration_environment": {
            "defaultValue": null,
            "type": "string"
        },
        "currentStack": {
            "defaultValue": "dotnetcore",
            "type": "string"
        },
        "rgLocation": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location for all resources."
            }
        }
    },
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.Web/sites",
            "apiVersion": "2021-02-01",
            "name": "[parameters('api_name')]",
            "location": "[parameters('rgLocation')]",
            "tags": {
                "agency": "[parameters('agency')]",
                "project": "[parameters('project')]",
                "division": "[parameters('division')]",
                "environment": "[parameters('environment')]"
            },
            "dependsOn": [
                "[concat('microsoft.insights/components/', parameters('api_name'))]"
            ],
            "kind": "app",
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "enabled": true,
                "hostNameSslStates": [
                    {
                        "name": "[concat(parameters('api_name'), '.azurewebsites.net')]",
                        "sslState": "Disabled",
                        "hostType": "Standard"
                    },
                    {
                        "name": "[concat(parameters('api_name'), '.scm.azurewebsites.net')]",
                        "sslState": "Disabled",
                        "hostType": "Repository"
                    }
                ],
                "serverFarmId": "[parameters('appServicePlan_Id')]",
                "reserved": false,
                "isXenon": false,
                "hyperV": false,
                "siteConfig": {
                    "numberOfWorkers": 1,
                    "acrUseManagedIdentityCreds": false,
                    "alwaysOn": false,
                    "http20Enabled": false,
                    "functionAppScaleLimit": 0,
                    "minimumElasticInstanceCount": 1,
                    "appSettings": [
                        {
                            "name": "ASPNETCORE_ENVIRONMENT",
                            "value": "[parameters('configuration_environment')]"
                        },

                        {
                            "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                            "value": "[reference(concat('microsoft.insights/components/', parameters('api_name'))).InstrumentationKey]"
                        },
                        {
                            "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                            "value": "[reference(concat('microsoft.insights/components/', parameters('api_name'))).ConnectionString]"
                        },
                        {
                            "name": "ApplicationInsightsAgent_EXTENSION_VERSION",
                            "value": "~2"
                        },
                        {
                            "name": "XDT_MicrosoftApplicationInsights_Mode",
                            "value": "default"
                        }
                    ],
                    "metadata": [
                        {
                            "name": "CURRENT_STACK",
                            "value": "[parameters('currentStack')]"
                        }
                    ]
                },
                "scmSiteAlsoStopped": false,
                "clientAffinityEnabled": true,
                "clientCertEnabled": false,
                "clientCertMode": "Required",
                "hostNamesDisabled": false,
                "customDomainVerificationId": "3110892397A9E0A9EF20FAADFCB61C65C51223FC98A79CC8D44705CEEC9B9BA0",
                "containerSize": 0,
                "dailyMemoryTimeQuota": 0,
                "httpsOnly": false,
                "redundancyMode": "None",
                "storageAccountRequired": false,
                "keyVaultReferenceIdentity": "SystemAssigned"
            }
        },
