<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests: pure functions only. Nothing here starts the API, opens a
    database, or talks to Redis - every test is "new it up, call it, compare".
    The HTTP-level checks live in WeShopAlot.Testing.WebApis.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pins the patched version of a transitive dependency (CVE-2026-84008, NU1903 below 10.0.13). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeShopAlot.Data\WeShopAlot.Data.csproj" />
    <ProjectReference Include="..\WeShopAlot..WebAPI\WeShopAlot.WebAPI.csproj" />
  </ItemGroup>

</Project>
