<UserControl x:Class="WeShopAlot.UI.ClientWPF.View.StripeCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="500">
    <!-- A small browser running Payment/stripe-card.html (Stripe.js), as in the Angular checkout -->
    <StackPanel>
        <TextBlock x:Name="StatusText" Text="Loading the Stripe card form…" Foreground="{StaticResource SlateBrush}" FontSize="{StaticResource FontSizeSmall}" Margin="0 0 0 4"/>
        <wv2:WebView2 x:Name="CardBrowser" Height="64"/>
    </StackPanel>
</UserControl>
