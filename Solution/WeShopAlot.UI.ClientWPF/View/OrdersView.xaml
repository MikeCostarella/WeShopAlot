<UserControl x:Class="WeShopAlot.UI.ClientWPF.View.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="{StaticResource MaxWidth}" Margin="32 24 32 32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConv}}">
            <TextBlock Text="You have no orders yet."/>
            <Button Content="Go shopping" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0 15 0 0"
                    Command="{Binding ShopCommand}"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}" RowHeight="52" VerticalAlignment="Top"
                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConv}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ORDER" Binding="{Binding Id, StringFormat='# {0}'}" Width="90"/>
                <DataGridTextColumn Header="DATE" Binding="{Binding LocalOrderDate, Mode=OneWay, StringFormat=g}" Width="*"/>
                <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=C}" Width="120"/>
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="160"/>
                <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="View" Style="{StaticResource SmallSecondaryButtonStyle}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.ViewOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" Text="Loading…" FontSize="20" Foreground="{StaticResource SlateBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 60 0 0"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConv}}"/>
    </Grid>
    </ScrollViewer>
</UserControl>
