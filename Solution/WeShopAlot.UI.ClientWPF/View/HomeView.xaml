<UserControl x:Class="WeShopAlot.UI.ClientWPF.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             xmlns:controls="clr-namespace:WeShopAlot.UI.ClientWPF.Controls">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="700">
        <controls:HeaderControl Height="130"/>
        <TextBlock Text="Welcome to WeShopAlot" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0 30 0 10"/>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="16" Foreground="{StaticResource MutedBrush}"
                   Text="This desktop app and the Angular site are two clients of the same ASP.NET Core REST API: the same products, basket, sign-in, checkout and orders."/>
        <Button Content="Shop now" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0 25 0 0"
                Command="{Binding ShopCommand}"/>
    </StackPanel>
</UserControl>
