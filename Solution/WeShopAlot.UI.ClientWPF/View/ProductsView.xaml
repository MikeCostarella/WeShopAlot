<UserControl x:Class="WeShopAlot.UI.ClientWPF.View.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Shop" Style="{StaticResource PageTitleStyle}"/>

        <!-- Filters: each one becomes a query-string parameter on GET /api/product -->
        <WrapPanel Grid.Row="1" Margin="0 0 0 10">
            <TextBlock Text="Brand" VerticalAlignment="Center" Margin="0 0 5 0"/>
            <ComboBox Width="150" Margin="0 0 15 5"
                      ItemsSource="{Binding Brands}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedBrand}"/>

            <TextBlock Text="Type" VerticalAlignment="Center" Margin="0 0 5 0"/>
            <ComboBox Width="150" Margin="0 0 15 5"
                      ItemsSource="{Binding Types}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedType}"/>

            <TextBlock Text="Sort" VerticalAlignment="Center" Margin="0 0 5 0"/>
            <ComboBox Width="160" Margin="0 0 15 5"
                      ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedSort}"/>

            <TextBox Width="180" Margin="0 0 5 5" ToolTip="Search by name, then press Enter"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Search" Padding="10 3" Margin="0 0 5 5" Command="{Binding SearchCommand}"/>
            <Button Content="Reset" Padding="10 3" Margin="0 0 5 5" Command="{Binding ResetCommand}"/>
            <Button Content="Refresh" Padding="10 3" Margin="0 0 5 5" Command="{Binding RefreshCommand}"/>
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Products}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                  HeadersVisibility="Column" RowHeight="60" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- PictureUrl is a full https URL served by the API -->
                            <Image Source="{Binding PictureUrl, TargetNullValue={x:Null}}" Height="50" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Brand" Binding="{Binding ProductBrand}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ProductType}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="90"/>
                <DataGridTemplateColumn Header="" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Details" Style="{StaticResource SmallButtonStyle}" Margin="0 0 6 0"
                                        Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Add to basket" Style="{StaticResource SmallButtonStyle}"
                                        Command="{Binding DataContext.AddToBasketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Loading…" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConv}}"/>

        <DockPanel Grid.Row="3" Margin="0 10 0 0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Next ›" Padding="10 3" Command="{Binding NextPageCommand}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding PageSummary}" Margin="10 0" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="‹ Previous" Padding="10 3" Command="{Binding PreviousPageCommand}"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555555"
                       FontFamily="Consolas"/>
        </DockPanel>
    </Grid>
</UserControl>
