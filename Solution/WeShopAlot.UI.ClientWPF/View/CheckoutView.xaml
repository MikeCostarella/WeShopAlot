<UserControl x:Class="WeShopAlot.UI.ClientWPF.View.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:view="clr-namespace:WeShopAlot.UI.ClientWPF.View"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000">
    <UserControl.Resources>
        <!-- Step pills, like Angular's stepper: maple, the current step in the brand color -->
        <Style x:Key="StepHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeNav}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepActiveStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource WhiteBrush}"/>
        </Style>
        <Style x:Key="FieldStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0 0 12 6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="{StaticResource MaxWidth}" Margin="32 24 32 32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <!-- Step headers: Address / Delivery / Review / Payment -->
                <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Height="52" Margin="0 0 0 20">
                    <Grid Background="{StaticResource MapleBrush}">
                        <TextBlock Text="1 · ADDRESS" Style="{StaticResource StepHeaderStyle}"/>
                        <Border Style="{StaticResource StepActiveStyle}"
                                Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVisibilityConv}, ConverterParameter=0}">
                            <TextBlock Text="1 · ADDRESS" Style="{StaticResource StepHeaderStyle}" Foreground="{StaticResource WhiteBrush}"/>
                        </Border>
                    </Grid>
                    <Grid Background="{StaticResource MapleBrush}">
                        <TextBlock Text="2 · DELIVERY" Style="{StaticResource StepHeaderStyle}"/>
                        <Border Style="{StaticResource StepActiveStyle}"
                                Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVisibilityConv}, ConverterParameter=1}">
                            <TextBlock Text="2 · DELIVERY" Style="{StaticResource StepHeaderStyle}" Foreground="{StaticResource WhiteBrush}"/>
                        </Border>
                    </Grid>
                    <Grid Background="{StaticResource MapleBrush}">
                        <TextBlock Text="3 · REVIEW" Style="{StaticResource StepHeaderStyle}"/>
                        <Border Style="{StaticResource StepActiveStyle}"
                                Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVisibilityConv}, ConverterParameter=2}">
                            <TextBlock Text="3 · REVIEW" Style="{StaticResource StepHeaderStyle}" Foreground="{StaticResource WhiteBrush}"/>
                        </Border>
                    </Grid>
                    <Grid Background="{StaticResource MapleBrush}">
                        <TextBlock Text="4 · PAYMENT" Style="{StaticResource StepHeaderStyle}"/>
                        <Border Style="{StaticResource StepActiveStyle}"
                                Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVisibilityConv}, ConverterParameter=3}">
                            <TextBlock Text="4 · PAYMENT" Style="{StaticResource StepHeaderStyle}" Foreground="{StaticResource WhiteBrush}"/>
                        </Border>
                    </Grid>
                </UniformGrid>

                <TextBlock DockPanel.Dock="Bottom" Text="Working…" Foreground="{StaticResource SlateBrush}" Margin="0 10 0 0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConv}}"/>

                <Grid>
                    <!-- ================= Step 1: Address ================= -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVisibilityConv}, ConverterParameter=0}">
                        <DockPanel Margin="0 0 0 5">
                            <Button DockPanel.Dock="Right" Content="Save as default address" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SaveAddressCommand}"/>
                            <TextBlock Text="Shipping address" Style="{StaticResource SectionTitleStyle}"/>
                        </DockPanel>
                        <UniformGrid Columns="2">
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <TextBlock Text="First name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <TextBlock Text="Last name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <TextBlock Text="Street" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <TextBlock Text="City" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <TextBlock Text="State (2 letters)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" CharacterCasing="Upper"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <TextBlock Text="Zip code" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Zipcode, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
                            </StackPanel>
                        </UniformGrid>
                        <DockPanel Margin="0 20 0 0">
                            <Button DockPanel.Dock="Right" Content="Go to delivery ›" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ToDeliveryCommand}"/>
                            <Button Content="‹ Back to basket" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                                    Command="{Binding BackToBasketCommand}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- ================= Step 2: Delivery ================= -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVisibilityConv}, ConverterParameter=1}">
                        <TextBlock Text="Choose a delivery method" Style="{StaticResource SectionTitleStyle}"/>
                        <ListBox ItemsSource="{Binding DeliveryMethods}" SelectedItem="{Binding SelectedDeliveryMethod}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="DeliveryMethod" Margin="0 6" Focusable="False"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <StackPanel Margin="6 0 0 0">
                                            <TextBlock FontWeight="SemiBold" FontSize="15">
                                                <Run Text="{Binding ShortName, Mode=OneWay}"/><Run Text=" – "/><Run Text="{Binding Price, Mode=OneWay, StringFormat=C}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource SlateBrush}" FontSize="{StaticResource FontSizeSmall}">
                                                <Run Text="{Binding Description, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding DeliveryTime, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Margin="0 20 0 0">
                            <Button DockPanel.Dock="Right" Content="Go to review ›" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ToReviewCommand}"/>
                            <Button Content="‹ Back to address" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                                    Command="{Binding BackCommand}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- ================= Step 3: Review ================= -->
                    <DockPanel Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVisibilityConv}, ConverterParameter=2}">
                        <TextBlock DockPanel.Dock="Top" Text="Review your order" Style="{StaticResource SectionTitleStyle}"/>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0 20 0 0">
                            <Button DockPanel.Dock="Right" Content="Go to payment ›" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ToPaymentCommand}"/>
                            <Button Content="‹ Back to delivery" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                                    Command="{Binding BackCommand}"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Items}" CanUserSortColumns="False" RowHeight="64" VerticalAlignment="Top">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="PRODUCT" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{StaticResource MapleBrush}" CornerRadius="6" Width="56" Height="46" Margin="0 0 12 0">
                                                    <Image Source="{Binding PictureUrl, TargetNullValue={x:Null}}" Stretch="Uniform" Margin="4"/>
                                                </Border>
                                                <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="18"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat=C}" Width="90"/>
                                <DataGridTextColumn Header="QUANTITY" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal, Mode=OneWay, StringFormat=C}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- ================= Step 4: Payment ================= -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVisibilityConv}, ConverterParameter=3}">
                        <TextBlock Text="Payment" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Name on card" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding NameOnCard, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                        <view:StripeCardControl/>
                        <TextBlock Text="{Binding CardError}" Foreground="{StaticResource DangerBrush}" Margin="0 4 0 0"
                                   Visibility="{Binding CardError, Converter={StaticResource NotEmptyToVisibilityConv}}"/>
                        <DockPanel Margin="0 20 0 0">
                            <Button DockPanel.Dock="Right" Content="Submit order" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SubmitOrderCommand}"/>
                            <Button Content="‹ Back to review" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                                    Command="{Binding BackCommand}"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- Order summary, beside every step (Angular's app-basket-summary / order totals) -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="24 0 0 0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="ORDER SUMMARY" Style="{StaticResource CapsLabelStyle}" FontSize="17" Margin="0 0 0 10"/>
                    <DockPanel Margin="0 4"><TextBlock Text="{Binding Totals.Subtotal, StringFormat=C}" DockPanel.Dock="Right"/><TextBlock Text="Order subtotal"/></DockPanel>
                    <DockPanel Margin="0 4"><TextBlock Text="{Binding Totals.Shipping, StringFormat=C}" DockPanel.Dock="Right"/><TextBlock Text="Shipping and handling"/></DockPanel>
                    <DockPanel Margin="0 4"><TextBlock Text="{Binding Totals.Total, StringFormat=C}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Total" FontWeight="Bold"/></DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
