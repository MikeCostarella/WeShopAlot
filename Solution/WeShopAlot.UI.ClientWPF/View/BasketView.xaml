<UserControl x:Class="WeShopAlot.UI.ClientWPF.View.BasketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Your basket" Style="{StaticResource PageTitleStyle}"/>

        <!-- Empty basket -->
        <StackPanel Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConv}}">
            <TextBlock Text="There are no items in your basket." FontSize="16"/>
            <Button Content="Go shopping" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0 15 0 0"
                    Command="{Binding ShopCommand}"/>
        </StackPanel>

        <Grid Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConv}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                      HeadersVisibility="Column" RowHeight="64" GridLinesVisibility="Horizontal" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Product" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding PictureUrl, TargetNullValue={x:Null}}" Width="56" Height="56" Margin="0 0 10 0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{StaticResource MutedBrush}">
                                            <Run Text="{Binding Brand, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Type, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="90"/>
                    <DataGridTemplateColumn Header="Quantity" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="−" Style="{StaticResource SmallButtonStyle}"
                                            Command="{Binding DataContext.DecrementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding Quantity}" Width="36" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="+" Style="{StaticResource SmallButtonStyle}"
                                            Command="{Binding DataContext.IncrementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, Mode=OneWay, StringFormat=C}" Width="100"/>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" Style="{StaticResource SmallButtonStyle}" VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" Padding="15" Margin="20 0 0 0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Order summary" Style="{StaticResource SectionTitleStyle}" Margin="0 0 0 10"/>
                    <TextBlock Text="Shipping costs will be calculated based on choices made during checkout" TextWrapping="Wrap"
                               FontStyle="Italic" Foreground="{StaticResource MutedBrush}" Margin="0 0 0 10"/>
                    <DockPanel Margin="0 4"><TextBlock Text="{Binding Totals.Subtotal, StringFormat=C}" DockPanel.Dock="Right"/><TextBlock Text="Order subtotal"/></DockPanel>
                    <DockPanel Margin="0 4"><TextBlock Text="{Binding Totals.Shipping, StringFormat=C}" DockPanel.Dock="Right"/><TextBlock Text="Shipping and handling"/></DockPanel>
                    <DockPanel Margin="0 4"><TextBlock Text="{Binding Totals.Total, StringFormat=C}" DockPanel.Dock="Right" FontWeight="Bold"/><TextBlock Text="Total" FontWeight="Bold"/></DockPanel>
                    <Button Content="Proceed to checkout" Style="{StaticResource PrimaryButtonStyle}" Margin="0 15 0 0"
                            Command="{Binding CheckoutCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
