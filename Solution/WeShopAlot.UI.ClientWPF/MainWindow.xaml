<Window x:Class="WeShopAlot.UI.ClientWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:WeShopAlot.UI.ClientWPF.View"
        xmlns:viewModel="clr-namespace:WeShopAlot.UI.ClientWPF.ViewModel"
        mc:Ignorable="d"
        Title="WeShopAlot" Height="800" Width="1200" MinHeight="600" MinWidth="900">
    <Window.Resources>
        <!-- Navigating = setting CurrentPage; these templates pick the view for each page view model -->
        <DataTemplate DataType="{x:Type viewModel:HomeViewModel}"><view:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ProductsViewModel}"><view:ProductsView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ProductDetailsViewModel}"><view:ProductDetailsView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:BasketViewModel}"><view:BasketView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:LoginViewModel}"><view:LoginView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:RegisterViewModel}"><view:RegisterView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:CheckoutViewModel}"><view:CheckoutView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:CheckoutSuccessViewModel}"><view:CheckoutSuccessView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:OrdersViewModel}"><view:OrdersView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:OrderDetailViewModel}"><view:OrderDetailView/></DataTemplate>

        <Style x:Key="BannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Padding" Value="15 8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nav bar (Angular's nav-bar component) -->
        <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="0 0 0 1" Padding="15 6">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButtonStyle}" Command="{Binding HomeCommand}" Padding="0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/logo.png" Height="40" Margin="0 0 8 0"/>
                        <TextBlock Text="WeShopAlot" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding BasketCommand}">
                        <TextBlock>
                            <Run Text="🛒 Basket ("/><Run Text="{Binding BasketCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <!-- Signed out -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBooleanToVisibilityConv}}">
                        <Button Content="Login" Style="{StaticResource NavButtonStyle}" Command="{Binding LoginCommand}"/>
                        <Button Content="Sign up" Style="{StaticResource NavButtonStyle}" Command="{Binding RegisterCommand}"/>
                    </StackPanel>

                    <!-- Signed in -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConv}}">
                        <TextBlock Text="{Binding WelcomeText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12 0"/>
                        <Button Content="View orders" Style="{StaticResource NavButtonStyle}" Command="{Binding OrdersCommand}"/>
                        <Button Content="Logout" Style="{StaticResource NavButtonStyle}" Command="{Binding LogoutCommand}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="HOME" Style="{StaticResource NavButtonStyle}" Command="{Binding HomeCommand}"/>
                    <Button Content="SHOP" Style="{StaticResource NavButtonStyle}" Command="{Binding ShopCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Notices (Angular uses ngx-toastr) -->
        <Border Grid.Row="1" Style="{StaticResource BannerStyle}"
                Visibility="{Binding Message, Converter={StaticResource NotEmptyToVisibilityConv}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Background="Transparent" BorderThickness="0" Foreground="White"
                        FontSize="14" Cursor="Hand" Command="{Binding DismissMessageCommand}"/>
                <TextBlock Text="{Binding Message}" Foreground="White" FontSize="15" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- The current page -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False"/>

        <StatusBar Grid.Row="3">
            <StatusBarItem Content=" (c) Latvian Village Cloudware"/>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="API: "/><Run Text="{Binding ApiAddress, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="#C62828"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
