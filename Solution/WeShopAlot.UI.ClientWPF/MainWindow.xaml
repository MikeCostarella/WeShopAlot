<Window x:Class="WeShopAlot.UI.ClientWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:WeShopAlot.UI.ClientWPF.View"
        xmlns:viewModel="clr-namespace:WeShopAlot.UI.ClientWPF.ViewModel"
        mc:Ignorable="d"
        Title="WeShopAlot" Icon="/Images/app.ico" Height="860" Width="1280" MinHeight="600" MinWidth="900"
        FontFamily="{StaticResource BodyFont}" FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource InkBrush}" Background="{StaticResource WhiteBrush}">
    <Window.Resources>
        <!-- Navigating = setting CurrentPage; these templates pick the view for each page view model -->
        <DataTemplate DataType="{x:Type viewModel:HomeViewModel}"><view:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ProductsViewModel}"><view:ProductsView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ProductDetailsViewModel}"><view:ProductDetailsView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:BasketViewModel}"><view:BasketView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:LoginViewModel}"><view:LoginView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:RegisterViewModel}"><view:RegisterView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:CheckoutViewModel}"><view:CheckoutView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:CheckoutSuccessViewModel}"><view:CheckoutSuccessView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:OrdersViewModel}"><view:OrdersView/></DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:OrderDetailViewModel}"><view:OrderDetailView/></DataTemplate>

        <Style x:Key="BannerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Padding" Value="24 8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- HOME / SHOP: the current one is underlined in the brand color -->
        <Style x:Key="NavUnderlineStyle" TargetType="Border">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Margin" Value="12 0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Header (Angular's nav-bar) ============ -->
        <Border Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource FretBrush}" BorderThickness="0 0 0 1" Padding="24 10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButtonStyle}" Command="{Binding OpenMenuCommand}"
                        AutomationProperties.Name="Open menu" ToolTip="Menu">
                    <Path Data="M4 7 H20 M4 12 H20 M4 17 H20" Stroke="{StaticResource InkBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                </Button>

                <Button DockPanel.Dock="Left" Style="{StaticResource LinkButtonStyle}" Command="{Binding HomeCommand}"
                        Margin="18 0 0 0" AutomationProperties.Name="WeShopAlot home">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource PickMark}" Width="32" Height="34" Margin="0 0 10 0"/>
                        <TextBlock Style="{StaticResource WordmarkStyle}">WeShop<Run Foreground="{StaticResource PrimaryBrush}">Alot</Run></TextBlock>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="30 0 0 0">
                    <StackPanel>
                        <Button Content="HOME" Style="{StaticResource NavButtonStyle}" Command="{Binding HomeCommand}"/>
                        <Border Style="{StaticResource NavUnderlineStyle}"
                                Visibility="{Binding IsHomePage, Converter={StaticResource BooleanToVisibilityConv}}"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Content="SHOP" Style="{StaticResource NavButtonStyle}" Command="{Binding ShopCommand}"/>
                        <Border Style="{StaticResource NavUnderlineStyle}"
                                Visibility="{Binding IsShopPage, Converter={StaticResource BooleanToVisibilityConv}}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Basket with the count badge -->
                    <Button Style="{StaticResource IconButtonStyle}" BorderThickness="0" Background="Transparent" Width="52"
                            Command="{Binding BasketCommand}" AutomationProperties.Name="Basket" ToolTip="Basket">
                        <Grid>
                            <Path Data="M3 4 H5 L7.4 15.2 A2 2 0 0 0 9.4 16.8 H17.1 A2 2 0 0 0 19.1 15.3 L21 8 H6"
                                  Stroke="{StaticResource InkBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="26" Stretch="None"/>
                            <Ellipse Width="2.8" Height="2.8" Fill="{StaticResource InkBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8.6 18.6 0 0"/>
                            <Ellipse Width="2.8" Height="2.8" Fill="{StaticResource InkBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15.6 18.6 0 0"/>
                            <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -6 -14 0"
                                    Visibility="{Binding BasketCount, Converter={StaticResource PositiveToVisibilityConv}}">
                                <TextBlock Text="{Binding BasketCount}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Signed out -->
                    <StackPanel Orientation="Horizontal" Margin="12 0 0 0"
                                Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBooleanToVisibilityConv}}">
                        <Button Content="Login" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoginCommand}"/>
                        <Button Content="Sign up" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RegisterCommand}" Margin="8 0 0 0"/>
                    </StackPanel>

                    <!-- Signed in: "Welcome Mike ▾" opens View basket / View orders / Logout, like Angular's dropdown -->
                    <Button x:Name="UserButton" Style="{StaticResource NavButtonStyle}" FontFamily="{StaticResource BodyFont}"
                            FontSize="{StaticResource FontSizeBody}" Margin="8 0 0 0" Click="UserButton_Click"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConv}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding WelcomeText}" VerticalAlignment="Center"/>
                            <Path Data="M0 0 L5 5 L10 0" Stroke="{StaticResource InkBrush}" StrokeThickness="2" VerticalAlignment="Center"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="8 2 0 0"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu FontSize="{StaticResource FontSizeBody}">
                                <MenuItem Header="View basket" Command="{Binding BasketCommand}"/>
                                <MenuItem Header="View orders" Command="{Binding OrdersCommand}"/>
                                <Separator/>
                                <MenuItem Header="Logout" Command="{Binding LogoutCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Notices (Angular uses ngx-toastr) ============ -->
        <Border Grid.Row="1" Style="{StaticResource BannerStyle}"
                Visibility="{Binding Message, Converter={StaticResource NotEmptyToVisibilityConv}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource LinkButtonStyle}" Foreground="White"
                        MinHeight="0" Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss"/>
                <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ============ Page band: title + breadcrumb (hidden on Home) ============ -->
        <Border Grid.Row="2" Background="{StaticResource MapleBrush}" BorderBrush="{StaticResource FretBrush}" BorderThickness="0 0 0 1"
                Visibility="{Binding PageTitle, Converter={StaticResource NotEmptyToVisibilityConv}}">
            <DockPanel MaxWidth="{StaticResource MaxWidth}" Margin="32 22">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Breadcrumb}" Style="{StaticResource MutedTextStyle}"
                           FontSize="15" VerticalAlignment="Bottom" Margin="0 0 0 6"/>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}"/>
            </DockPanel>
        </Border>

        <!-- ============ The current page ============ -->
        <ContentControl Grid.Row="3" Content="{Binding CurrentPage}" Focusable="False"/>

        <!-- ============ Status bar: the same facts as the Angular footer ============ -->
        <Border Grid.Row="4" Background="{StaticResource InkBrush}" Padding="24 8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding BuildText}" Foreground="{StaticResource FooterTextBrush}" FontSize="13"/>
                <TextBlock Foreground="{StaticResource FooterTextBrush}" FontSize="13">
                    <Run Text="WPF client · API "/><Run Text="{Binding ApiOrigin, Mode=OneWay}"/>
                    <Run Text="{Binding ConnectionStatus, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ============ Hamburger menu: backdrop + drawer, over everything ============ -->
        <Grid Grid.RowSpan="5" Visibility="{Binding IsMenuOpen, Converter={StaticResource BooleanToVisibilityConv}}">
            <Border Background="{StaticResource OverlayBrush}" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"/>
            <Border Width="{StaticResource MenuWidth}" HorizontalAlignment="Left" Background="{StaticResource WhiteBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="0" Opacity="0.25"/>
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource FretBrush}" BorderThickness="0 0 0 1" Padding="16 10">
                        <DockPanel>
                            <Button x:Name="CloseMenuButton" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" BorderThickness="0"
                                    Command="{Binding CloseMenuCommand}" AutomationProperties.Name="Close menu">
                                <Path Data="M6 6 L18 18 M18 6 L6 18" Stroke="{StaticResource InkBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource PickMark}" Width="28" Height="30" Margin="0 0 10 0"/>
                                <TextBlock Style="{StaticResource WordmarkStyle}" FontSize="26">WeShop<Run Foreground="{StaticResource PrimaryBrush}">Alot</Run></TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Bottom" Padding="20 12" Style="{StaticResource MutedTextStyle}" FontSize="13">
                        <Run Text="WPF client · "/><Run Text="{Binding BuildText, Mode=OneWay}"/>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0 8 0 0">
                            <!-- Shop -->
                            <Expander Style="{StaticResource MenuSectionStyle}" IsExpanded="True" Header="SHOP">
                                <StackPanel>
                                    <Button Content="All products" Style="{StaticResource MenuItemButtonStyle}" Command="{Binding ShowTypeCommand}"/>
                                    <ItemsControl ItemsSource="{Binding ProductTypes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}" Style="{StaticResource MenuItemButtonStyle}"
                                                        Command="{Binding DataContext.ShowTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <!-- My account -->
                            <Expander Style="{StaticResource MenuSectionStyle}" IsExpanded="True" Header="MY ACCOUNT">
                                <StackPanel>
                                    <TextBlock Text="{Binding SignedInAs}" Style="{StaticResource MutedTextStyle}" Margin="36 6 20 6"
                                               Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConv}}"/>
                                    <Button Style="{StaticResource MenuItemButtonStyle}" Command="{Binding BasketCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Basket" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource BadgeStyle}" Margin="8 0 0 0"
                                                    Visibility="{Binding BasketCount, Converter={StaticResource PositiveToVisibilityConv}}">
                                                <TextBlock Text="{Binding BasketCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConv}}">
                                        <Button Content="My orders" Style="{StaticResource MenuItemButtonStyle}" Command="{Binding OrdersCommand}"/>
                                        <Button Content="Sign out" Style="{StaticResource MenuItemButtonStyle}" Command="{Binding LogoutCommand}"/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBooleanToVisibilityConv}}">
                                        <Button Content="Login" Style="{StaticResource MenuItemButtonStyle}" Command="{Binding LoginCommand}"/>
                                        <Button Content="Sign up" Style="{StaticResource MenuItemButtonStyle}" Command="{Binding RegisterCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- View -->
                            <Expander Style="{StaticResource MenuSectionStyle}">
                                <Expander.Header>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding View.ModeName}" FontFamily="{StaticResource BodyFont}"
                                                   FontWeight="Normal" FontSize="13" Foreground="{StaticResource SlateBrush}" Margin="0 0 10 0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="VIEW" Style="{StaticResource MenuSectionHeaderTextStyle}"/>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel Margin="36 6 20 6">
                                    <RadioButton Content="Products as cards" GroupName="MenuView" IsChecked="{Binding View.ShowCards}" Margin="0 4"/>
                                    <RadioButton Content="Products as a list" GroupName="MenuView" IsChecked="{Binding View.ShowList}" Margin="0 4"/>
                                </StackPanel>
                            </Expander>

                            <!-- Links -->
                            <Expander Style="{StaticResource MenuSectionStyle}" Header="LINKS">
                                <StackPanel>
                                    <Button Content="API reference (Swagger)" Style="{StaticResource MenuItemButtonStyle}"
                                            Command="{Binding OpenLinkCommand}" CommandParameter="{Binding SwaggerUrl}"/>
                                    <Button Content="Course site" Style="{StaticResource MenuItemButtonStyle}"
                                            Command="{Binding OpenLinkCommand}" CommandParameter="{Binding CourseSite}"/>
                                    <Button Content="Source on GitHub" Style="{StaticResource MenuItemButtonStyle}"
                                            Command="{Binding OpenLinkCommand}" CommandParameter="{Binding GitHub}"/>
                                </StackPanel>
                            </Expander>

                            <!-- About -->
                            <Expander Style="{StaticResource MenuSectionStyle}" BorderThickness="0" Header="ABOUT">
                                <StackPanel Margin="36 6 20 6">
                                    <TextBlock Text="WeShopAlot, WPF desktop client. The Angular client uses the same REST API."
                                               TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0 0 0 6"/>
                                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0 0 0 6">
                                        <Run Text="API: "/><Run Text="{Binding ApiAddress, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding BuildText}" Style="{StaticResource MutedTextStyle}"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
