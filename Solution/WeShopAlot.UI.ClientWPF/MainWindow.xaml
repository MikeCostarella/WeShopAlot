<Window x:Class="WeShopAlot.UI.ClientWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeShopAlot.UI.ClientWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Admin">
                <Grid Background="#FFE5E5E5">
                    <DockPanel Margin="5,10,5,10">
                        <Menu DockPanel.Dock="Top">
                            <MenuItem Header="_Product">
                                <MenuItem Header="_Add" />
                            </MenuItem>
                        </Menu>
                        <TextBox AcceptsReturn="True" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Shop">
                <Grid Background="#FFE5E5E5">
                    <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="20,42,20,50"/>
                </Grid>
            </TabItem>
            <TabItem Header="Ohio">
                <Grid Background="#FFE5E5E5" Height="406"/>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
