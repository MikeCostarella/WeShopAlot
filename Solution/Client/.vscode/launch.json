{
  // Visual Studio (Client.esproj) opens the first configuration after "npm start" is up.
  // VS Code users can pick "ng serve", which starts the dev server itself.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chrome (https://localhost:4200)",
      "type": "chrome",
      "request": "launch",
      "url": "https://localhost:4200",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "https://localhost:4200"
    }
  ]
}
